+// Fingerprint capture for the varuna_lean kernel re-check (see its PROVENANCE).
+#[cfg(test)]
+mod fingerprint_capture {
+    use crate::{
+        crypto_hash::PoseidonSponge,
+        r1cs::{ConstraintSynthesizer, ConstraintSystem, SynthesisError},
+        snark::varuna::{VarunaHidingMode, VarunaSNARK, VarunaVersion, ahp::AHPForR1CS, varuna::fingerprint},
+        traits::{AlgebraicSponge, SNARK},
+    };
+    use snarkvm_curves::bls12_377::{Bls12_377, Fq, Fr};
+    use snarkvm_utilities::rand::TestRng;
+    use std::collections::BTreeMap;
+
+    type FS = PoseidonSponge<Fq, 2, 1>;
+    type Inst = VarunaSNARK<Bls12_377, FS, VarunaHidingMode>;
+
+    /// Fixed seed so the capture is reproducible.
+    const SEED: u64 = 0x07A0_2026;
+
+    /// The two circuits of the batch. `prove_batch` takes one constraint type,
+    /// so both are variants of one enum.
+    ///
+    /// `Unbalanced`: one public input, five constraints, and `A` rows with
+    /// several terms, so its three non-zero domains differ (`|K_A| = 16`,
+    /// `|K_B| = |K_C| = 8`) and the matrix-sumcheck selectors carry a real
+    /// `|K_M| / |K|` scale.
+    ///
+    /// `Product`: three public inputs `p, q, r = (pq)^2` and one private
+    /// `u = pq`. With the three randomizing variables and the extra constraint
+    /// of hiding mode, its constraint, variable, and non-zero domains are all
+    /// smaller than `Unbalanced`'s and its input domain is larger, so the
+    /// selectors at `alpha`, `beta`, and `gamma` all carry a scale.
+    #[derive(Clone)]
+    enum Fixture {
+        Unbalanced { x: u64, a: u64, b: u64 },
+        Product { p: u64, q: u64 },
+    }
+
+    impl Fixture {
+        /// Public inputs, with the leading constant `1` the verifier expects.
+        fn inputs(&self) -> Vec<Fr> {
+            let f = |v: u64| Fr::from(v);
+            match *self {
+                Self::Unbalanced { x, .. } => vec![f(1), f(x)],
+                Self::Product { p, q } => vec![f(1), f(p), f(q), f(p * q * p * q)],
+            }
+        }
+    }
+
+    impl ConstraintSynthesizer<Fr> for Fixture {
+        fn generate_constraints<CS: ConstraintSystem<Fr>>(&self, cs: &mut CS) -> Result<(), SynthesisError> {
+            let f = |v: u64| Fr::from(v);
+            let one = CS::one();
+            match *self {
+                Self::Unbalanced { x: xv, a: av, b: bv } => {
+                    let (cv, dv, gv) = (av + bv + xv, (av + bv) * av, xv * xv);
+                    let ev = av + bv + cv + dv;
+                    let x = cs.alloc_input(|| "x", || Ok(f(xv)))?;
+                    let a = cs.alloc(|| "a", || Ok(f(av)))?;
+                    let b = cs.alloc(|| "b", || Ok(f(bv)))?;
+                    let c = cs.alloc(|| "c", || Ok(f(cv)))?; // (a + b + x) * 1
+                    let d = cs.alloc(|| "d", || Ok(f(dv)))?; // (a + b) * a
+                    let e = cs.alloc(|| "e", || Ok(f(ev)))?; // (a + b + c + d) * 1
+                    let g = cs.alloc(|| "g", || Ok(f(gv)))?; // x * x
+                    let h = cs.alloc(|| "h", || Ok(f(ev + gv)))?; // (e + g) * 1
+                    cs.enforce(|| "c", |lc| lc + a + b + x, |lc| lc + one, |lc| lc + c);
+                    cs.enforce(|| "d", |lc| lc + a + b, |lc| lc + a, |lc| lc + d);
+                    cs.enforce(|| "e", |lc| lc + a + b + c + d, |lc| lc + one, |lc| lc + e);
+                    cs.enforce(|| "g", |lc| lc + x, |lc| lc + x, |lc| lc + g);
+                    cs.enforce(|| "h", |lc| lc + e + g, |lc| lc + one, |lc| lc + h);
+                }
+                Self::Product { p: pv, q: qv } => {
+                    let uv = pv * qv;
+                    let p = cs.alloc_input(|| "p", || Ok(f(pv)))?;
+                    let q = cs.alloc_input(|| "q", || Ok(f(qv)))?;
+                    let r = cs.alloc_input(|| "r", || Ok(f(uv * uv)))?; // u * u
+                    let u = cs.alloc(|| "u", || Ok(f(uv)))?; // p * q
+                    cs.enforce(|| "u", |lc| lc + p, |lc| lc + q, |lc| lc + u);
+                    cs.enforce(|| "r", |lc| lc + u, |lc| lc + u, |lc| lc + r);
+                }
+            }
+            Ok(())
+        }
+    }
+
+    #[test]
+    fn capture_zero_eval_lc_fingerprint() {
+        let rng = &mut TestRng::fixed(SEED);
+        let max_degree = AHPForR1CS::<Fr, VarunaHidingMode>::max_degree(100, 25, 300).unwrap();
+        let srs = Inst::universal_setup(max_degree).unwrap();
+        let prover = &srs.to_universal_prover().unwrap();
+        let verifier = &srs.to_universal_verifier().unwrap();
+        let fs = FS::sample_parameters();
+
+        // Two circuits, two instances each.
+        let unbalanced = [Fixture::Unbalanced { x: 3, a: 1, b: 2 }, Fixture::Unbalanced { x: 5, a: 2, b: 7 }];
+        let product = [Fixture::Product { p: 2, q: 3 }, Fixture::Product { p: 5, q: 7 }];
+        let (pk_u, vk_u) = Inst::circuit_setup(&srs, &unbalanced[0]).unwrap();
+        let (pk_p, vk_p) = Inst::circuit_setup(&srs, &product[0]).unwrap();
+        let keys_to_constraints = BTreeMap::from([(&pk_u, &unbalanced[..]), (&pk_p, &product[..])]);
+
+        let path = std::env::var("VARUNA_FINGERPRINT_OUT").unwrap_or_else(|_| "/tmp/varuna_lc_fingerprint.json".into());
+        fingerprint::set(Some(path.clone()));
+        let proof = Inst::prove_batch(prover, &fs, VarunaVersion::V3, &keys_to_constraints, rng);
+        fingerprint::set(None);
+        let proof = proof.unwrap();
+
+        let inputs_u = unbalanced.iter().map(Fixture::inputs).collect::<Vec<_>>();
+        let inputs_p = product.iter().map(Fixture::inputs).collect::<Vec<_>>();
+        let keys_to_inputs = BTreeMap::from([(&vk_u, &inputs_u[..]), (&vk_p, &inputs_p[..])]);
+        assert!(
+            Inst::verify_batch(verifier, &fs, VarunaVersion::V3, &keys_to_inputs, &proof).unwrap(),
+            "captured proof verifies"
+        );
+        println!("wrote fingerprint to {path}");
+        println!("circuit ids: Unbalanced = {}, Product = {}", pk_u.circuit.id, pk_p.circuit.id);
+    }
+}
